<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hw_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="@style/HwTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="History and trends" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tabHeart"
            style="@style/HwTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Heart" />

        <Button
            android:id="@+id/tabBp"
            style="@style/HwTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BP" />

        <Button
            android:id="@+id/tabResp"
            style="@style/HwTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Resp." />

        <Button
            android:id="@+id/tabSpo2"
            style="@style/HwTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SpO₂" />
    </LinearLayout>

    <TextView
        android:id="@+id/chartSummary"
        style="@style/HwBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp" />

    <com.example.yo7a.healthwatcher.TrendChartView
        android:id="@+id/trendChart"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card" />

    <TextView
        android:id="@+id/historyEmpty"
        style="@style/HwBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="No measurements stored yet. Completed measurements appear here."
        android:visibility="gone" />

    <ListView
        android:id="@+id/historyList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp" />

    <Button
        android:id="@+id/clearHistory"
        style="@style/HwSecondaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Delete history" />
</LinearLayout>
